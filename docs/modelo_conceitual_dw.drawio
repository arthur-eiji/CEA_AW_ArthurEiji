=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="br"><mxGeometry y="52" width="320" height="26" as="geometry"/></mxCell><mxCell id="br_2" value="sales_reason_id" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="br"><mxGeometry y="78" width="320" height="26" as="geometry"/></mxCell><mxCell id="br_3" value="grão: 1 linha por pedido × motivo (um pedido pode ter vários)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="br"><mxGeometry y="104" width="320" height="26" as="geometry"/></mxCell><mxCell id="br_4" value="Fonte: sales_salesorderheadersalesreason" style="text;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=9;fontStyle=2;" vertex="1" parent="br"><mxGeometry y="130" width="320" height="26" as="geometry"/></mxCell><mxCell id="dsr" value="dim_sales_reason" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1180" y="850" width="310" height="156" as="geometry"/></mxCell><mxCell id="dsr_0" value="&lt;b&gt;PK&lt;/b&gt;&amp;nbsp; sales_reason_key" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dsr"><mxGeometry y="26" width="310" height="26" as="geometry"/></mxCell><mxCell id="dsr_1" value="sales_reason_id (NK)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dsr"><mxGeometry y="52" width="310" height="26" as="geometry"/></mxCell><mxCell id="dsr_2" value="sales_reason_name (On Promotion, Price, …)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dsr"><mxGeometry y="78" width="310" height="26" as="geometry"/></mxCell><mxCell id="dsr_3" value="reason_type (Promotion, Marketing, Other)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=11;" vertex="1" parent="dsr"><mxGeometry y="104" width="310" height="26" as="geometry"/></mxCell><mxCell id="dsr_4" value="Fonte: sales_salesreason" style="text;strokeColor=none;fillColor=#f5f5f5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=9;fontStyle=2;" vertex="1" parent="dsr"><mxGeometry y="130" width="310" height="26" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;Diagrama Conceitual — Data Warehouse Adventure Works (área de Vendas)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Star schema · Databricks (catálogo fea_academy) + dbt Core · camadas: raw (adventure_works) → staging (14 views) → marts (dimensões, fato e ponte) → consumo para o BI (rpt_sales e rpt_sales_by_reason)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60" y="14" width="1430" height="60" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Notas de modelagem&lt;/b&gt;&lt;br&gt;• Grão da fato: 1 linha por item de pedido (sales_salesorderdetail).&lt;br&gt;• Nº de pedidos = count(distinct sales_order_id): medida não aditiva, calculada no BI.&lt;br&gt;• Motivo de venda é N:N com o pedido → tabela-ponte, usada só ao filtrar ou agrupar por motivo (evita fan-out na fato).&lt;br&gt;• Chaves: surrogate keys md5 (dbt_utils.generate_surrogate_key); dimensões conformadas.&lt;br&gt;• Qualidade: a staging fixa tipos (IDs → bigint, datas → date) e corrige defeitos da ingestão (código &amp;quot;NA&amp;quot; da Namíbia, espaço duplo em um motivo de venda).&lt;br&gt;• Consumo para o BI: rpt_sales (fato + dimensões, mesmo grão) e rpt_sales_by_reason (grão item × motivo, ex.: &amp;quot;On Promotion&amp;quot;).&lt;br&gt;• Teste de dado: vendas brutas de 2011 = US$ 12.646.112,16 (Σ gross_amount)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=10;fillColor=#fffbe6;strokeColor=#d6b656;spacing=6;" vertex="1" parent="1"><mxGeometry x="60" y="880" width="520" height="170" as="geometry"/></mxCell><mxCell id="e_date" value="order_date_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="dd" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_cust" value="customer_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dc" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_geo" value="ship_geography_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="dg" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_prod" value="product_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="dp" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_card" value="credit_card_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dcc" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_status" value="order_status_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="dos" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_reason" value="sales_reason_key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERone;startFill=0;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dsr" target="br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e_bridge" value="sales_order_id (N:N via ponte)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#ffffff;endArrow=ERmany;endFill=0;startArrow=ERmany;startFill=0;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="br" target="fs"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>

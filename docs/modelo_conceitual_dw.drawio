        <mxCell id="br4" value="grão: 1 linha por pedido × motivo (um pedido pode ter vários)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;fontSize=10;fontStyle=2;" vertex="1" parent="br"><mxGeometry y="104" width="320" height="26" as="geometry"/></mxCell>
